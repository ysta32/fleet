{
  "name": "@fleet/site",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "dev": "node scripts/prebuild.mjs && next dev -p 4530",
    "preview": "node scripts/serve.mjs 4530",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test scripts/*.test.mjs",
    "assets": "node scripts/prebuild.mjs && node scripts/assets.mjs",
    "postbuild": "node scripts/defer-hydration.mjs && node scripts/check-out.mjs"
  },
  "dependencies": {
    "@fleet/shared": "1.1.1",
    "@fleet/ui": "1.1.1",
    "@fleet/web": "1.1.1",
    "next": "15.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "vite": "5.4.11",
    "@vitejs/plugin-react": "4.3.4",
    "sharp": "0.34.5"
  }
}
