{
  "name": "fleet-spend",
  "version": "1.1.1",
  "description": "Local, private spend tracker for AI coding agents (Claude Code, Codex, Cursor, Copilot, Anthropic/OpenAI APIs)",
  "type": "module",
  "bin": {
    "fleet-spend": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@fleet/shared": "1.1.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
